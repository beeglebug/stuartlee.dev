---
interface Props {
  text: string;
  top: string;
  discoveriesLabel: string;
  completionLabel: string;
}
const { text, top, discoveriesLabel, completionLabel } = Astro.props;
---

<footer class="site-footer wrap">
  <slot name="appearance" />
  <div class="footer-row">
    <p>
      <span class="footer-name">Stuart Lee</span>
      <span>{text}</span>
    </p>
    <div class="footer-actions">
      <button
        id="discoveries-toggle"
        aria-expanded="false"
        aria-controls="discoveries-panel"
        aria-haspopup="dialog"
        hidden
      >
        {discoveriesLabel}
        <span id="discovery-count"></span>
        <span
          id="discovery-star"
          class="discovery-star"
          aria-label={completionLabel}
          hidden
        >
          ★
        </span>
      </button>
      <a href="#top">
        {top}
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>
