---
import ThemeControl from './ThemeControl.astro';
---

<footer class="site-footer wrap">
  <ThemeControl />
  <div class="footer-row">
    <p>
      <span class="footer-name">© {new Date().getFullYear()} Stuart Lee.</span>
    </p>
    <div class="footer-actions">
      <button
        id="discoveries-toggle"
        aria-expanded="false"
        aria-controls="discoveries-panel"
        aria-haspopup="dialog"
        hidden
      >
        Achievements
        <span id="discovery-count"></span>
        <span
          id="discovery-star"
          class="discovery-star"
          aria-label="All six achievements unlocked! 100% complete. ★"
          hidden
        >
          ★
        </span>
      </button>
      <a href="#top">
        Back to top
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 32px;
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .footer-row > p {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: var(--text-small);
    color: var(--muted);
  }
  .footer-name {
    font-weight: 600;
    color: var(--ink);
  }
  .footer-actions {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
  }
  .footer-actions a,
  .footer-actions button {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    gap: 8px;
    font-size: var(--text-small);
  }
  .footer-actions button {
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  #discovery-count {
    font-size: var(--text-small);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .footer-row > p {
      flex-direction: column;
      gap: 0;
    }
  }
  @media print {
    .footer-actions {
      display: none !important;
    }
  }
  .discovery-star {
    color: var(--accent);
    font-size: var(--text-body);
  }
</style>
