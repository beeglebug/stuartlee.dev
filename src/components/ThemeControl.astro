---
interface Props {
  label: string;
  light: string;
  dark: string;
  system: string;
}
const { label, light, dark, system } = Astro.props;
const choices = [
  { value: 'light', label: light },
  { value: 'dark', label: dark },
  { value: 'system', label: system },
];
---

<div class="theme-control" role="group" aria-label={label} hidden>
  <span>{label}</span>
  {choices.map((theme) => (
    <button
      type="button"
      data-theme-choice={theme.value}
      aria-pressed={theme.value === 'system' ? 'true' : 'false'}
    >
      {theme.label}
    </button>
  ))}
</div>
<script>
  import '../scripts/theme';
</script>
