---
import type { Project, ProjectFieldLabels } from '../content/types';

interface Props {
  label: string;
  title: string;
  status: string;
  intro: string;
  note: string;
  fields: ProjectFieldLabels;
  caseStudies: Project[];
}
const { label, title, status, intro, note, fields, caseStudies } = Astro.props;
---

<section
  class="section wrap projects-section"
  id="projects"
  aria-labelledby="projects-heading"
  data-discovery-section="projects"
>
  <div class="section-heading">
    <p class="eyebrow">{label}</p>
    <h2 id="projects-heading">
      {title.split('\n').map((line) => (
        <span>{line}</span>
      ))}
    </h2>
  </div>
  <div class="project-content">
    {caseStudies.length === 0 ? (
      <div class="coming-soon">
        <p class="small-label">
          <span class="status-mark" aria-hidden="true"></span>
          {status}
        </p>
        <p>{intro}</p>
        <p class="project-note">{note}</p>
        <a class="text-link" href="https://www.linkedin.com/in/beeglebug/">
          LinkedIn<span aria-hidden="true">↗</span>
        </a>
      </div>
    ) : (
      caseStudies.map((project) => (
        <article class="case-study" id={project.id}>
          <h3>{project.title}</h3>
          <dl>
            {Object.entries(fields).map(([key, label]) => (
              <>
                <dt>{label}</dt>
                <dd>{project[key as keyof typeof fields]}</dd>
              </>
            ))}
          </dl>
        </article>
      ))
    )}
  </div>
</section>
