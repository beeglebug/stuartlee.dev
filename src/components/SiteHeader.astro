---
import type { Locale } from '../content/types';

interface Props {
  locale: Locale;
  label: string;
  about: string;
  approach: string;
  projects: string;
  languages: string;
}
const { locale, label, about, approach, projects, languages } = Astro.props;
const base = locale === 'en' ? '/' : '/de/';
---

<header class="site-header wrap" id="top">
  <a class="wordmark" href={base} aria-label="Stuart Lee">
    <span>Stuart Lee</span>
  </a>
  <nav aria-label={label} class="main-nav">
    <a href="#about">{about}</a>
    <a href="#approach">{approach}</a>
    <a href="#projects">{projects}</a>
  </nav>
  <nav class="language-nav" aria-label={languages}>
    <a
      href="/"
      lang="en"
      hreflang="en"
      aria-current={locale === 'en' ? 'page' : undefined}
      data-language="en"
    >
      English
    </a>
    <span aria-hidden="true">/</span>
    <a
      href="/de/"
      lang="de"
      hreflang="de"
      aria-current={locale === 'de' ? 'page' : undefined}
      data-language="de"
    >
      Deutsch
    </a>
  </nav>
</header>
