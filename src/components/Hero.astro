---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  contact: string;
  more: string;
  note: string;
}
const { eyebrow, title, intro, contact, more, note } = Astro.props;
---

<section
  class="hero wrap"
  aria-labelledby="hero-heading"
  data-discovery-section="intro"
>
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="blue-dot" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 id="hero-heading">
      {title.split('\n').map((line, i) => (
        <span class={i === 1 ? 'accent' : undefined}>{line}</span>
      ))}
    </h1>
    <p class="hero-intro">{intro}</p>
    <div class="actions">
      <a class="button" href="https://www.linkedin.com/in/beeglebug/">
        {contact}
        <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#about">
        {more}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <p class="hero-note">{note}</p>
  </div>
</section>
