---
import type { Translation } from '../content/types';
import { achievementIds } from '../content/site';
interface Props {
  content: Translation['game'];
}
const { content } = Astro.props;
---

<dialog
  id="discoveries-panel"
  aria-labelledby="discoveries-heading"
  class="discoveries-panel"
>
  <button id="discoveries-close" class="dialog-close" type="button" autofocus>
    {content.close}
    <span aria-hidden="true">×</span>
  </button>
  <h2 id="discoveries-heading">{content.heading}</h2>
  <p>{content.intro}</p>
  <div id="explorer-badge" class="explorer-badge" hidden>
    <strong>✦ {content.explorer}</strong>
    <p>{content.complete}</p>
  </div>
  {[false, true].map((bonus) => (
    <div class="achievement-group">
      <h3>{bonus ? content.bonusLabel : content.mainLabel}</h3>
      <ul class="achievement-list">
        {achievementIds
          .filter((id) => (id === 'console' || id === 'source') === bonus)
          .map((id) => (
            <li data-achievement={id}>
              <div class="achievement-title">
                <span class="achievement-mark" aria-hidden="true">
                  ○
                </span>
                <h4>{content.achievements[id].title}</h4>
                <span class="achievement-state">{content.locked}</span>
              </div>
              <details>
                <summary>{content.hint}</summary>
                <p>{content.achievements[id].hint}</p>
              </details>
            </li>
          ))}
      </ul>
    </div>
  ))}
  <form id="source-form" class="source-form">
    <label for="source-code">{content.sourceLabel}</label>
    <div>
      <input
        id="source-code"
        name="code"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={content.sourcePlaceholder}
        aria-describedby="source-feedback"
      />
      <button class="button" type="submit">
        {content.submit}
      </button>
    </div>
    <p id="source-feedback" role="status"></p>
  </form>
  <button id="reset-discoveries" class="reset-button" type="button">
    {content.reset}
  </button>
</dialog>
<div
  id="achievement-notification"
  class="notification"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>
<script
  id="game-translations"
  type="application/json"
  set:html={JSON.stringify(content).replace(/</g, '\\u003c')}
/>
<script>
  import '../scripts/achievements';
</script>
