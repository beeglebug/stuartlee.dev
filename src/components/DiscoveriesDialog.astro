---
import type { AchievementTranslations } from '../content/types';
import { achievementIds } from '../content/site';
interface Props {
  close: string;
  heading: string;
  intro: string;
  mainLabel: string;
  bonusLabel: string;
  locked: string;
  unlocked: string;
  hint: string;
  sourceLabel: string;
  sourcePlaceholder: string;
  submit: string;
  invalid: string;
  sourceSuccess: string;
  reset: string;
  resetDone: string;
  award: string;
  explorer: string;
  complete: string;
  consoleClue: string;
  allComplete: string;
  achievements: AchievementTranslations;
}
const {
  close,
  heading,
  intro,
  mainLabel,
  bonusLabel,
  locked,
  unlocked,
  hint,
  sourceLabel,
  sourcePlaceholder,
  submit,
  invalid,
  sourceSuccess,
  reset,
  resetDone,
  award,
  explorer,
  complete,
  consoleClue,
  allComplete,
  achievements,
} = Astro.props;
const gameTranslations = {
  close,
  heading,
  intro,
  mainLabel,
  bonusLabel,
  locked,
  unlocked,
  hint,
  sourceLabel,
  sourcePlaceholder,
  submit,
  invalid,
  sourceSuccess,
  reset,
  resetDone,
  award,
  explorer,
  complete,
  consoleClue,
  allComplete,
  achievements,
};
---

<dialog
  id="discoveries-panel"
  aria-labelledby="discoveries-heading"
  class="discoveries-panel"
>
  <button id="discoveries-close" class="dialog-close" type="button" autofocus>
    {close}
    <span aria-hidden="true">×</span>
  </button>
  <h2 id="discoveries-heading">{heading}</h2>
  <p>{intro}</p>
  <div id="explorer-badge" class="explorer-badge" hidden>
    <strong>✦ {explorer}</strong>
    <p>{complete}</p>
  </div>
  {[false, true].map((bonus) => (
    <div class="achievement-group">
      <h3>{bonus ? bonusLabel : mainLabel}</h3>
      <ul class="achievement-list">
        {achievementIds
          .filter((id) => (id === 'console' || id === 'source') === bonus)
          .map((id) => (
            <li data-achievement={id}>
              <div class="achievement-title">
                <span class="achievement-mark" aria-hidden="true">
                  ○
                </span>
                <h4>{achievements[id].title}</h4>
                <span class="achievement-state">{locked}</span>
              </div>
              <details>
                <summary>{hint}</summary>
                <p>{achievements[id].hint}</p>
              </details>
            </li>
          ))}
      </ul>
    </div>
  ))}
  <form id="source-form" class="source-form">
    <label for="source-code">{sourceLabel}</label>
    <div>
      <input
        id="source-code"
        name="code"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={sourcePlaceholder}
        aria-describedby="source-feedback"
      />
      <button class="button" type="submit">
        {submit}
      </button>
    </div>
    <p id="source-feedback" role="status"></p>
  </form>
  <button id="reset-discoveries" class="reset-button" type="button">
    {reset}
  </button>
</dialog>
<div
  id="achievement-notification"
  class="notification"
  popover="manual"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>
<div
  id="completion-notification"
  class="notification completion-notification"
  popover="manual"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>
<script
  id="game-translations"
  type="application/json"
  set:html={JSON.stringify(gameTranslations).replace(/</g, '\\u003c')}
/>
<script>
  import '../scripts/achievements';
</script>
