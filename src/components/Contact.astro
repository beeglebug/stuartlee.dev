---
interface Props {
  label: string;
  title: string;
  text: string;
  cta: string;
  github: string;
}
const { label, title, text, cta, github } = Astro.props;
---

<section
  class="contact-section"
  id="contact"
  aria-labelledby="contact-heading"
  data-discovery-section="contact"
>
  <div class="wrap contact-inner">
    <p class="eyebrow">{label}</p>
    <h2 id="contact-heading">
      {title.split('\n').map((line) => (
        <span>{line}</span>
      ))}
    </h2>
    <p>{text}</p>
    <div class="actions">
      <a class="button" href="https://www.linkedin.com/in/beeglebug/">
        {cta}
        <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="https://github.com/beeglebug">
        {github}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
