---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  robots?: string;
}

const {
  title = 'Stuart Lee — Senior Frontend Engineer',
  description =
    'Stuart Lee, Senior Frontend Engineer based in the UK. React, TypeScript and accessible web applications.',
  path = '/',
  robots,
} = Astro.props;
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fa" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('stuartlee:theme');
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
      } catch {
        /* System appearance works without storage. */
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {robots && <meta name="googlebot" content={robots} />}
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta
      property="og:image"
      content="https://stuartlee.dev/social-preview.png"
    />
    <meta
      property="og:image:alt"
      content={title}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- Explorer's code: BUILT-WITH-CARE. Enter it in Achievements. -->
    <a class="skip-link" href="#main" data-skip>
      Skip to content
    </a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    z-index: 10;
    padding: 12px 20px;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  @media print {
    .skip-link {
      display: none !important;
    }
  }
</style>
